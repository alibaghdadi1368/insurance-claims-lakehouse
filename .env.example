# Copy to .env and fill in. Never commit .env.

# Snowflake
SNOWFLAKE_ACCOUNT=xy12345.eu-central-1
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=WH_PIPELINE

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
S3_BUCKET=polder-insurance-landing-yourname

# Airflow in Docker (phase 6): your Linux user id, from `id -u`
AIRFLOW_UID=1000
