{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLandingFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::polder-insurance-landing-yourname/landing/*"
    },
    {
      "Sid": "ListLandingFolder",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::polder-insurance-landing-yourname",
      "Condition": {"StringLike": {"s3:prefix": ["landing/*"]}}
    }
  ]
}